# Local development only. On Databricks Apps these come from app.yaml.
# Copy to .env and fill in the technical-user OAuth client. .env is gitignored.

DATASPHERE_BASE_URL=https://your-tenant.eu10.hcs.cloud.sap
DATASPHERE_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
DATASPHERE_CLIENT_ID=
DATASPHERE_CLIENT_SECRET=
# Optional. Leave empty unless the OAuth client requires a scope.
DATASPHERE_SCOPE=
DATABRICKS_APP_PORT=8000
LOG_LEVEL=INFO
